# ─────────────────────────────────────────────────────────────────────────────
# MOROCCO LEGAL PLATFORM — environment
# Copy to .env.local (Next.js runtime) and .env (Prisma CLI) and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# PostgreSQL (Supabase). The platform owns a dedicated schema so it never
# touches tables of other applications living in the same database.
#   ?schema=legal_platform
DATABASE_URL=

# ── Application identity / branding (§61: never hard-code a final brand) ─────
NEXT_PUBLIC_APP_NAME=MOROCCO_LEGAL_PLATFORM
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.ma
NEXT_PUBLIC_SUPPORT_PHONE=
APP_URL=http://localhost:3010
# Primary language for the UI when no preference is stored ("fr" | "ar").
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# ── AI provider (optional) ───────────────────────────────────────────────────
# mock  = deterministic, offline intent/normalisation provider (default).
# openai = real LLM for language understanding and prose. Legal routing is
#          ALWAYS decided by the routing engine, never by the model.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=20000

# ── Payment provider (§26: abstraction, mock is clearly labelled) ────────────
# mock = records the payment attempt locally and requires explicit
#        server-side confirmation; never presented as a real charge.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=MAD

# ── Signature provider (§22: never fake a legal e-signature) ─────────────────
# mock = local, non-qualified signature sandbox used for development only.
# It is labelled MOCK everywhere in the UI and never claims legal validity.
SIGNATURE_PROVIDER=mock

# ── Document storage (§23) ───────────────────────────────────────────────────
# local    = filesystem under DOCUMENT_STORAGE_DIR (dev default), served only
#            through authenticated route handlers (never a public URL).
# supabase = Supabase Storage bucket when SUPABASE_SERVICE_ROLE_KEY is set.
DOCUMENT_STORAGE=local
DOCUMENT_STORAGE_DIR=.data/documents
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=legal-documents

# ── Email (§44) ──────────────────────────────────────────────────────────────
# console = renders the message into the server log + in-app notification.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="MOROCCO LEGAL PLATFORM <no-reply@example.ma>"

# ── Session ──────────────────────────────────────────────────────────────────
# Optional: salt/pepper for session token hashing (a random value is used in
# development when empty).
AUTH_SESSION_SECRET=
SESSION_TTL_HOURS=720
