{
  "name": "morocco-legal-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Morocco-first legal contract platform: client intent -> structured case -> legal routing -> draft -> self-service or lawyer validation/signature -> final contract.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify": "tsx scripts/verify.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "qa": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
